# Configuration de Production Dokploy Malihub pour forms.malihub.digital

# --- Client Nuxt (.env dans client/) ---
NUXT_LOG_LEVEL=info
NUXT_PUBLIC_APP_URL=https://forms.malihub.digital
NUXT_PUBLIC_API_BASE=https://forms.malihub.digital/api
NUXT_API_SECRET=your-secure-front-api-secret
NUXT_PUBLIC_ENV=production
# Redirection de la landing page vers le portail autonome
NUXT_PUBLIC_ROOT_REDIRECT_URL=https://formulaires.malihub.digital


# --- API Laravel (.env dans api/) ---
APP_NAME="Formulaire Facile Mali"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_KEY_WITH_PHP_ARTISAN_KEY_GENERATE
APP_URL=https://forms.malihub.digital

FRONT_URL=https://forms.malihub.digital
FRONT_API_SECRET=your-secure-front-api-secret

# Base de données PostgreSQL interne au compose
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=forge_secure_password_replace_in_prod

# Redis interne au compose
REDIS_HOST=redis
REDIS_PORT=6379

# Stockage et Filesystem
FILESYSTEM_DRIVER=local

# Queues & Cache
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# JWT
JWT_TTL=10080
JWT_REMEMBER_TTL=43200
JWT_SECRET=generate_jwt_secret_32_chars_or_more
JWT_SKIP_IP_UA_VALIDATION=false
